# Copy to .env and adjust per environment
# API base URL for backend (no trailing slash)
REACT_APP_API_URL=http://localhost:5000/api
# Optional: when REACT_APP_API_URL is NOT set, the app calls the API on the
# same host as the opened page using this port. Default 5000. This is what
# makes LAN-IP / port-forward access work without rebuilding.
# REACT_APP_API_PORT=5000
# Admin Live Tracking maps use OpenStreetMap + Leaflet (no API key required).
